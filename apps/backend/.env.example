# ─────────────────────────────────────────────────────────────────────────────
# CEDI Loan Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── PostgreSQL Database ───────────────────────────────────────────────────────
# Option A: single connection string (overrides individual vars below)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cedi_loan

# Option B: individual variables (used if DATABASE_URL is not set)
DB_NAME=cedi_loan
DB_USER=postgres
DB_PASS=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Sequelize sync mode: "force" (drop+create), "alter" (migrate), or leave blank (none)
# WARNING: "force" destroys all data. Only use in development.
DB_SYNC=

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRE=7d

# ── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# ── Email (optional — for notification emails) ────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM=CEDI Loan App <noreply@cediloan.com>

# ── Firebase Admin SDK (required for PIN reset verification) ──────────────────
# Get these from Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private key exactly as it appears in the downloaded JSON (including \n newlines)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Mobile Money API (placeholder — integrate actual provider SDK) ────────────
MTN_API_KEY=your-mtn-api-key
MTN_API_SECRET=your-mtn-api-secret
HUBTEL_API_KEY=your-hubtel-api-key
HUBTEL_API_SECRET=your-hubtel-api-secret
AIRTEL_API_KEY=your-airtel-api-key
AIRTEL_API_SECRET=your-airtel-api-secret

# ── Bridge API (mobile money collections) ─────────────────────────────────────
# Use either BRIDGE_BASIC_AUTH (already base64-encoded username:password)
# OR set BRIDGE_USERNAME and BRIDGE_PASSWORD.
BRIDGE_BASE_URL=https://api.bridgeagw.com
BRIDGE_SERVICE_ID=1
BRIDGE_BASIC_AUTH=
BRIDGE_USERNAME=
BRIDGE_PASSWORD=

# Public callback endpoint where Bridge will POST transaction updates.
# Example: https://your-domain.com/api/payments/webhook
# If not set, backend will try BACKEND_PUBLIC_URL + /api/payments/webhook.
BRIDGE_CALLBACK_URL=
BACKEND_PUBLIC_URL=

# Optional: request tuning and currency defaults
BRIDGE_TIMEOUT_MS=20000
BRIDGE_CURRENCY_CODE=GHS
BRIDGE_CURRENCY_VALUE=1

# ── Firebase (cedLoan React app only — NOT used by backend) ──────────────────
# These go in cedLoan/.env not here.
# REACT_APP_FIREBASE_API_KEY=
# REACT_APP_FIREBASE_AUTH_DOMAIN=
# REACT_APP_FIREBASE_PROJECT_ID=
# REACT_APP_FIREBASE_STORAGE_BUCKET=
# REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
# REACT_APP_FIREBASE_APP_ID=
